# Copy to .env and adjust. Every agent worktree sets its own COMPOSE_PROJECT_NAME
# and ports (see docs/AGENT_PROMPTS.md ports table). Never commit .env.
COMPOSE_PROJECT_NAME=otula-platform
BACKEND_PORT=8000
FRONTEND_PORT=5180

# Django
DEBUG=True
SECRET_KEY=django-insecure-local-dev-only-change-me
DATABASE_URL=postgres://otula:otula@db:5432/otula
POSTGRES_DB=otula
POSTGRES_USER=otula
POSTGRES_PASSWORD=otula
ALLOWED_HOSTS=localhost,127.0.0.1
FIELD_ENCRYPTION_KEY=2mHiBJLvN0dqOjNjvKmjtxmDHww4bHBM2ff1j2Y85ck=

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0

# Web push (VAPID) - generate with `python manage.py generate_vapid`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@example.com

# Demo seed data
DEMO_PASSWORD=otula-demo-1234

# Frontend (Vite)
VITE_API_URL=http://localhost:8000/api/v1
VITE_USE_MOCKS=true
