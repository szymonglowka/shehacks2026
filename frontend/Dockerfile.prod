# Produkcja (VPS project2): statyczny build Vite serwowany przez nginx.
# API bazowe jest wbudowane w build (VITE_API_URL) — ta sama domena (/api/).
# Na VPS: build z Dockerfile.prod (kontekst = ten katalog).
ARG VITE_API_URL=https://otula.hackyeah.site/api/v1

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL} VITE_USE_MOCKS=false
RUN npm run build

FROM nginx:alpine
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
