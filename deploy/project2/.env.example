# Otula PROD (.env) — /opt/infrastructure/projects/project2/.env, chmod 600.
# NIGDY nie commituj. Wartosci wygeneruj na serwerze (openssl / generate_vapid).
# Django
SECRET_KEY=<openssl rand -hex 48>
DEBUG=False
ALLOWED_HOSTS=otula.hackyeah.site
CSRF_TRUSTED_ORIGINS=https://otula.hackyeah.site
FIELD_ENCRYPTION_KEY=<python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">

# Postgres (haslo hex = bezpieczne w DATABASE_URL)
POSTGRES_DB=otula
POSTGRES_USER=otula
POSTGRES_PASSWORD=<openssl rand -hex 24>

# Web push (python manage.py generate_vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@otula.hackyeah.site

# Konto demo (seed_demo) — tylko do prezentacji
DEMO_PASSWORD=<ustaw silne>
